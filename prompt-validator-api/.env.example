# Server
PORT=3000

# OpenAI (existing — moderation / prompt validation)
OPENAI_API_KEY=

# ── Trend Photos (MongoDB + admin dashboard) ───────────────────────
# ADMIN_API_KEY - secret key used to authorize the private admin dashboard.
# Sent by the dashboard as the "X-Admin-Key" header on every admin request.
ADMIN_API_KEY=

# MongoDB connection string (MongoDB Atlas free tier M0 is enough).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional: database name (defaults to "dreampics" when omitted).
# MONGODB_DB=dreampics

# Rate limits (optional overrides)
# RATE_LIMIT_MAX=30
# TREND_RATE_LIMIT_MAX=120
# ADMIN_RATE_LIMIT_MAX=60